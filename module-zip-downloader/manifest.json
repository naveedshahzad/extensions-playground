{
  "manifest_version": 3,
  "name": "Cascade Module ZIP Downloader",
  "version": "1.0",
  "description": "For each module on a Cascade content page, clicks the first slide then triggers the Download ZIP button. Reports downloaded file paths.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://cascade.myunfc.ca/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://cascade.myunfc.ca/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
